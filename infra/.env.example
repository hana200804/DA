# Chép thành infra/.env rồi đổi mọi mật khẩu. infra/.env không được commit.
# Compose đọc file này; backend đọc cùng tên biến từ môi trường (backend/README.md).

# Chỉ container MySQL dùng.
MYSQL_ROOT_PASSWORD=change-me-root

# Tài khoản ứng dụng: backend chạy lâu dài chỉ cần nhóm này.
SIGNA_DB_APP_USER=signa_app
SIGNA_DB_APP_PASSWORD=change-me-app

# Tài khoản migration: chỉ dùng cho lệnh migrate chạy một lần.
SIGNA_DB_MIGRATOR_USER=signa_migrator
SIGNA_DB_MIGRATOR_PASSWORD=change-me-migrator

# MinIO: tài khoản gốc của container, backend dùng làm access key khi dev. Mật khẩu ≥ 8 ký tự.
SIGNA_MINIO_ACCESS_KEY=signa-dev
SIGNA_MINIO_SECRET_KEY=change-me-minio

# URL ký ảnh trả cho client; đổi khi điện thoại gọi qua IP LAN hoặc qua nginx.
# SIGNA_MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Quản trị viên đầu tiên: backend tạo khi chưa có ADMIN và có đủ hai biến. Để trống thì bỏ qua.
# Mật khẩu 8–72 ký tự, không có giá trị mặc định. Đổi mật khẩu sau lần đăng nhập đầu.
SIGNA_BOOTSTRAP_ADMIN_EMAIL=
SIGNA_BOOTSTRAP_ADMIN_PASSWORD=

# Backend web: tạo bí mật OTP riêng ngoài profile test, ví dụ openssl rand -hex 32.
SIGNA_OTP_SECRET=
# Host mặc định là localhost khi chạy Gradle và mailpit khi chạy Compose.
# SIGNA_SMTP_HOST=
# SIGNA_SMTP_PORT=1025
# SIGNA_SMTP_FROM=no-reply@signa.local
