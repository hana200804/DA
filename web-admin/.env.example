# demo: chạy độc lập bằng dữ liệu mẫu; api: gọi backend Spring Boot
VITE_DATA_MODE=demo
# API mode defaults to Signa. Set legacy for the walacker/traffic-sign backend.
VITE_API_CONTRACT=signa
# Gateway for Vite development. Docker defaults to http://nginx:80.
SIGNA_TARGET=http://localhost:8080
# Optional. Keep the tile provider attribution visible in the review map.
# VITE_REVIEW_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Vite chuyển tiếp request đến các dịch vụ sau trong môi trường phát triển.
AUTH_TARGET=http://localhost:8000
SIGN_TARGET=http://localhost:12000
RTTS_TARGET=http://localhost:11000
# Các đường dẫn dưới cần reverse proxy tương ứng khi triển khai bản build.
VITE_AUTH_BASE=/api/auth
VITE_SIGN_BASE=/api/signs
VITE_RTTS_BASE=/api/rtts
